    },
    "nginx": {
      "seriesLength": 2,
      "minimumBySeries": {"1.30": [1, 30, 6], "1.31": [1, 31, 7]},
      "sources": ["https://nginx.org/en/security_advisories.html"]
    }
  },
  "requiredRuntimesByRepository": {
    "docker.io/docker/dockerfile": [],
    "docker.io/library/node": ["node"],
    "cgr.dev/chainguard/node": ["node"],
    "docker.io/library/nginx": ["nginx"],
    "cgr.dev/chainguard/nginx": ["nginx"]
  }
}
