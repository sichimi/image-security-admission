  "requiredEvidenceHashes": ["sbom", "scan", "provenance", "advisoryReview"],
  "runtimeRules": {
    "node": {
      "seriesLength": 1,
      "minimumBySeries": {"22": [22, 23, 5], "24": [24, 22, 3], "26": [26, 13, 1]},
